# 生产环境变量模板
# 使用方法：复制为服务器上的 /opt/place-explore/backend/.env.prod
# 权限设置为 600，属主 placeapp，真实值不要提交到 Git
#
#   sudo cp .env.prod.example /opt/place-explore/backend/.env.prod
#   sudo chown placeapp:placeapp /opt/place-explore/backend/.env.prod
#   sudo chmod 600 /opt/place-explore/backend/.env.prod
#   然后手动填入真实值

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/place_explore
SPRING_DATASOURCE_USERNAME=place_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
SUPER_ADMIN_USERNAME=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME
AMAP_WEB_KEY=CHANGE_ME
APP_UPLOAD_AVATAR_DIR=/opt/place-explore/shared/uploads/avatars
APP_UPLOAD_POI_SHARE_DIR=/opt/place-explore/shared/uploads/poi-shares
APP_UPLOAD_ANNOUNCEMENT_DIR=/opt/place-explore/shared/uploads/announcements
APP_UPLOAD_ACTIVITY_DIR=/opt/place-explore/shared/uploads/activities
APP_UPLOAD_ROUTE_DIR=/opt/place-explore/shared/uploads/routes
